# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 커밋되지 않습니다.
# Vercel에도 같은 키를 Environment Variables에 등록해야 합니다.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 번들에 절대 노출하지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=

# LLM — Upstage Solar 단독 (2026-09-09 확정, 임베딩 포함)
UPSTAGE_API_KEY=

# 비용 라우트(upload, jobs/run) 임시 토큰 가드. OAuth(Step 7)가 대체할 때까지 필수.
# 없으면 해당 라우트는 전부 401 (fail-closed). 팀 공유 값 하나를 쓴다.
BLOG_API_TOKEN=

# GitHub REST (공개 레포 커밋 조회, 비로그인 상태의 rate limit 완화용)
GITHUB_TOKEN=
