{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "src/lib/parser/**/*.ts",
    "src/lib/pipeline/**/*.ts",
    "src/lib/github/**/*.ts",
    "src/lib/match/**/*.ts",
    "src/lib/masking/**/*.ts",
    "src/lib/portfolio/**/*.ts",
    "src/lib/prompts/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
