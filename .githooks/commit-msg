#!/bin/sh
# B-Log 규칙: 커밋 메시지에서 AI 도구의 공동 작성자 트레일러를 자동 제거한다.
# GitHub는 Co-Authored-By 를 contributors 에 집계하므로, Claude/Codex/Copilot 등이
# 기여자 목록에 뜨지 않게 한다. AI 사용은 README 와 세션 로그로 증명한다.
#
# 활성화: npm install 시 package.json 의 "prepare" 가 core.hooksPath 를 .githooks 로 설정한다.
# 수동:   git config core.hooksPath .githooks

MSG_FILE="$1"
PATTERN='^(Co-Authored-By|Co-authored-by|Signed-off-by):.*(claude|anthropic|codex|openai|chatgpt|gpt|copilot|cursor|gemini|google|devin|aider|windsurf|noreply)|Generated with \[?Claude|Generated by (Claude|Codex|Copilot|Cursor)|🤖 Generated'

if grep -Eiq "$PATTERN" "$MSG_FILE"; then
  TMP="$MSG_FILE.tmp"
  grep -Eiv "$PATTERN" "$MSG_FILE" > "$TMP"
  # 끝부분 빈 줄 정리
  sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$TMP" > "$MSG_FILE"
  rm -f "$TMP"
  echo "[b-log] AI 공동 작성자 트레일러를 커밋 메시지에서 제거했습니다." >&2
fi

exit 0
